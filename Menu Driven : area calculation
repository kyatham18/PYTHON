def sq():
    s=int(input("Enter the size : "))
    print("Area is: ",s*s)
def cir():
    r=int(input("Enter the radius : "))
    print("Area is: ",r*r*3.14)
def rec():
    l=int(input("Enter the length : "))
    b=int(input("Enter the breadth : "))
    print("Area is: ",l*b)
